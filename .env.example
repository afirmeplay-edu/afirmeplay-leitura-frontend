# =============================================================================
# Frontend (Next.js) — reinicie o dev server apos alterar variaveis NEXT_PUBLIC_*
# =============================================================================

NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
NEXT_PUBLIC_DEBUG_MODE=false

# Login mock local (sem afirmeplay_backend). Reinicie o dev server apos alterar.
MOCK_AUTH=true

# API da VPS central usada na listagem de municipios (somente server-side)
API_DISCOVERY_REMOTE_URL=https://prod-api.afirmeplay.com.br

# -----------------------------------------------------------------------------
# Opcional: listagem completa de municipios (server-side, nunca expor no client)
# -----------------------------------------------------------------------------

# Conexao direta com o Postgres da VPS central (prioridade maxima)
# CITIES_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Alternativa: login admin para buscar GET /city/ na VPS ou no backend local
# CITIES_DISCOVERY_REGISTRATION=seu.usuario@afirmeplay.com.br
# CITIES_DISCOVERY_PASSWORD=
